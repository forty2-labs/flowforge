# Copy to .env and adjust. Values match docker-compose.yml.
DATABASE_URL=postgresql://flowforge:flowforge@localhost:5432/flowforge
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Email through Resend (optional). Without a key, emails are written to the API
# log. MAIL_FROM must use a domain verified in Resend; the default shared
# sender only delivers to the Resend account's own address.
RESEND_API_KEY=
MAIL_FROM=Flowforge <onboarding@resend.dev>

# Web
API_URL=http://localhost:4000
