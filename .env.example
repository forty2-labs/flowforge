# Copy to .env and adjust. Values match docker-compose.yml.
DATABASE_URL=postgresql://flowforge:flowforge@localhost:5432/flowforge
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Email through Resend (optional). Without a key, emails are written to the API
# log. MAIL_FROM must use a domain verified in Resend; the default shared
# sender only delivers to the Resend account's own address.
RESEND_API_KEY=
MAIL_FROM=Flowforge <onboarding@resend.dev>

# Google sign-in through Supabase Auth (optional). Without a URL and anon key,
# the Google button says sign-in isn't set up and email and password work as
# before. Use a development Supabase project, never production.
# SUPABASE_JWT_SECRET is the legacy shared secret: leave it empty if the
# project uses signing keys. Next.js does not read this file, so to try Google
# sign-in locally also put SUPABASE_URL and SUPABASE_ANON_KEY in
# apps/web/.env.local.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Web
API_URL=http://localhost:4000
# Public address of the web app, for absolute links in page metadata.
SITE_URL=http://localhost:3000
